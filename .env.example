# Secreto para firmar la cookie de sesión (HMAC-SHA256). OBLIGATORIO en
# producción: sin él, la app falla al iniciar sesión (no usa fallback inseguro).
# Genera uno largo y aleatorio, p. ej.:  openssl rand -base64 48
# En Vercel: Settings → Environment Variables (Production y Preview).
# Para desarrollo local: copia este archivo a .env.local y pon cualquier valor.
SESSION_SECRET=cambia-este-secreto-en-produccion

# Base de datos del Foro (Postgres / Neon). Se crea desde Vercel (Storage →
# Neon), que la inyecta automáticamente en el proyecto. Para desarrollo local:
# `vercel env pull .env.local`. drizzle-kit usa esta variable para migrar.
DATABASE_URL=postgresql://usuario:clave@host/db?sslmode=require
